:root {
  --austen-gray: #646464;
  --austen-gray-dark: #333333;
  --austen-gray-light: rgb(170, 170, 170);
  --austen-green: rgb(16 132 67);
  --austen-red: rgb(231, 12, 33);
  --austen-teal: rgb(68, 121, 132);
}

#wrapper {
  margin-top: 20px; 
}

.site_title h1 {
  font-family: 'Alice', serif;
  font-size: 4.5em;
  margin: .2em 0 0 0;
  color: var(--austen-teal); 
}


.site_title h1 span {
  color: var(--austen-red); 
}


.site_title h2 {
  font-family: 'Josefin Sans', sans-serif;
  font-size: 1.8em;
  color: var(--austen-green);
  margin: 0 0 .5em 0; 
}

.header .navbar-default .navbar-nav > li > a {
  color: var(--austen-gray);
  text-decoration: none;
}

.header .navbar-default .navbar-nav > li > a:hover {
  color: var(--austen-gray-dark);
  text-decoration: underline;
}


.tei_element {
  color: var(--austen-red); 
}


.tei_attribute {
  color: var(--austen-teal); 
}


.tei_attribute_value {
  color: var(--austen-green); 
}

.header .navbar {
  font-size: 1.2em;
}


body {
